# Opcionales: sin overrides se usa DeepSeek Flash de OpenCode Go, esfuerzo max.
# Plantilla para exportar en la shell; la aplicación no carga este fichero.
AGENTVIEW_AI_MODEL=deepseek-v4.1-flash
AGENTVIEW_AI_EFFORT=max
AGENTVIEW_AI_API_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
# Omite esta variable para reutilizar herdr-gitview/opencode-go de opencode/auth.json.
AGENTVIEW_AI_API_KEY_VALUE=
